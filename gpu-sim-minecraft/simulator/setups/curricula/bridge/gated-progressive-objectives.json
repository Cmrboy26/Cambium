{
  "format": "minecraft_sim_training_plan",
  "version": 2,
  "name": "bridge-gated-progressive-objectives",
  "seed": 42,
  "policy": "../../policies/bridge/building-items.json",
  "environment": "../../environments/bridge/progression-narrow-objectives.json",
  "learner": {"hidden_dim": 128, "lr": 0.0003, "epochs": 2, "minibatch_size": 1024},
  "bridge_observation": {
    "format": "minecraft_sim_bridge_observation", "version": 2,
    "native_capabilities": {"bridge_host_batch_version": 2, "bridge_local_voxels_version": 1, "actor_task_state_version": 1},
    "voxel_shape": [5, 9, 9], "voxel_dtype": "uint8", "voxel_categories": 5,
    "match_features": ["own_score", "opponent_score", "match_remaining", "cage_remaining",
      "own_blocks", "own_golden_apples", "own_arrows", "own_refill_progress", "refill_enabled", "own_selected_slot",
      "own_eating_progress", "own_mining_progress", "objective_yaw_error", "objective_pitch_error", "objective_distance",
      "own_use_cooldown", "own_mining_cooldown"],
    "match_scales": ["goals_to_win", "goals_to_win", "max_ticks", "max(1,cage_ticks)", "64", "64", "64",
      "max(1,arrow_refill_ticks)", "1", "8", "32_ticks", "1", "180_degrees", "90_degrees", "50_blocks_clipped",
      "4_ticks", "5_ticks"],
    "voxel_perspective": "actor_feet_yaw_v1", "sampling": "current_host_state",
    "model": "bridge_voxel_actor_critic_v2"
  },
  "opponents": {
    "target": {"type": "scripted", "controller": "stationary_target"},
    "runner-sneak-jump": {"type": "scripted", "controller": "bridge_fixed_lane", "options": {"sneak": true, "jump": true}},
    "runner-jump": {"type": "scripted", "controller": "bridge_fixed_lane", "options": {"jump": true}},
    "bduel2": {"type": "checkpoint", "path": "../../../training/runs/BDuel2/snapshots/bridge-narrow-baseline.pt"},
    "past-self": {"type": "frozen_self_play", "every_updates": 20}
  },
  "mixtures": {"target": [{"id": "target", "weight": 1}], "runner": [
    {"id": "runner-sneak-jump", "weight": 1}, {"id": "runner-jump", "weight": 1}
  ], "runner-training": [
    {"id": "runner-sneak-jump", "weight": 1}, {"id": "runner-jump", "weight": 1},
    {"id": "bduel2", "weight": 1}, {"id": "past-self", "weight": 1}
  ]},
  "snapshots": [{"name": "initial", "at_updates": 0}],
  "stages": [
    {
      "name": "reach-goal-narrow", "opponents": "target",
      "controls": {"fixed": {"jump": false, "sprint": false, "sneak": false,
                             "attack": false, "yaw": 0, "pitch": 0, "weapon": 0, "use_item": false}},
      "evaluations": {
        "reach-a": {"every_updates": 10, "worlds": 8, "episodes": 16, "seed": 1729},
        "reach-b": {"every_updates": 10, "worlds": 8, "episodes": 16, "seed": 2718}
      },
      "advance": {"all": [
        {"evaluation": {"suite": "reach-a", "metric": "goals_for_mean", "at_least": 0.75}},
        {"evaluation": {"suite": "reach-b", "metric": "goals_for_mean", "at_least": 0.75}}
      ]},
      "snapshots": [{"name": "reach-goal-narrow", "on_completion": true}]
    },
    {
      "name": "defeat-target-narrow", "opponents": "target",
      "controls": {"fixed": {"sneak": false, "weapon": 0, "use_item": false}},
      "evaluations": {
        "target-a": {"every_updates": 10, "worlds": 8, "episodes": 16, "seed": 1729},
        "target-b": {"every_updates": 10, "worlds": 8, "episodes": 16, "seed": 2718}
      },
      "advance": {"all": [
        {"evaluation": {"suite": "target-a", "metric": "win_rate", "at_least": 0.75}},
        {"evaluation": {"suite": "target-b", "metric": "win_rate", "at_least": 0.75}}
      ]},
      "snapshots": [{"name": "defeat-target-narrow", "on_completion": true}]
    },
    {
      "name": "defeat-runner-narrow-no-blocks", "environment": "../../environments/bridge/progression-narrow-objectives-no-blocks.json",
      "opponents": "runner-training", "controls": {"fixed": {}},
      "evaluations": {
        "runner-no-blocks-a": {"overrides": {"opponents": "runner"}, "every_updates": 10, "worlds": 8, "episodes": 16, "seed": 1729},
        "runner-no-blocks-b": {"overrides": {"opponents": "runner"}, "every_updates": 10, "worlds": 8, "episodes": 16, "seed": 2718}
      },
      "task_override": {"rewards": {"doing_damage": 1}},
      "advance": {"all": [
        {"evaluation": {"suite": "runner-no-blocks-a", "metric": "win_rate", "at_least": 0.75}},
        {"evaluation": {"suite": "runner-no-blocks-b", "metric": "win_rate", "at_least": 0.75}}
      ]},
      "snapshots": [{"name": "bridge-narrow-no-blocks", "on_completion": true}]
    },
    {
      "name": "defeat-runner-narrow", "environment": "../../environments/bridge/progression-narrow-objectives.json",
      "opponents": "runner-training", "controls": {"fixed": {}},
      "evaluations": {
        "runner-a": {"overrides": {"opponents": "runner"}, "every_updates": 10, "worlds": 8, "episodes": 16, "seed": 1729},
        "runner-b": {"overrides": {"opponents": "runner"}, "every_updates": 10, "worlds": 8, "episodes": 16, "seed": 2718}
      },
      "task_override": {"rewards": {"doing_damage": 1}},
      "advance": {"all": [
        {"evaluation": {"suite": "runner-a", "metric": "win_rate", "at_least": 0.75}},
        {"evaluation": {"suite": "runner-b", "metric": "win_rate", "at_least": 0.75}}
      ]},
      "snapshots": [{"name": "bridge-narrow-baseline", "on_completion": true}]
    }
  ]
}